{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1",
    "^models/(.*)$": "<rootDir>/../models/$1",
    "^repository/(.*)$": "<rootDir>/../repository/$1",
    "^constant/(.*)$": "<rootDir>/../constant/$1"
  }
}
